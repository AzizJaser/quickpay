<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.quickpay</groupId>
    <artifactId>customer-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>customer-service</name>
    <description>QuickPay customer service — owns customer identity and sessions; the BFF for the channel (ADR-0006)</description>

    <properties>
        <java.version>21</java.version>
        <!-- Same JDK / Lombok note as the other modules: 1.18.36+ runs as an
             annotation processor on modern JDKs; declared in the compiler plugin below. -->
        <lombok.version>1.18.36</lombok.version>
    </properties>

    <dependencies>
        <!-- REST API — the channel's only entry point. This service authenticates the human
             (ADR-0006); wallet and bill authenticate the *service*, never the customer. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA — customers and sessions. Sessions live here in Postgres, NOT Redis:
             decisions-log entry 8. Redis is not earned; "sessions belong in Redis" is the
             same shape as "we need a circuit breaker", which five scenarios refused. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- RabbitMQ — this service PUBLISHES customer events so the notification service can
             keep its replicated copy of contact details up to date (data-ownership option A).
             Notification also inquires synchronously on a cache miss. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Bean validation on DTOs. Note for ADR-0006: the cif is varchar(10) everywhere
             (@Size(min=10,max=10) in the wallet's CreateWalletRequest) — keep it consistent
             here, because the wallet's ownership check compares these values directly. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Password hashing ONLY — spring-security-crypto is the BCrypt/Argon2 implementation
             WITHOUT the servlet filter chain. Deliberately not spring-boot-starter-security:
             this service authenticates humans with its own session mechanism, and pulling in
             the full starter would auto-configure a filter chain that fights it.
             Drop this dependency if you choose pre-seeded API keys over passwords. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Calls the wallet and the bill service on the customer's behalf (the BFF role).
             RestClient comes from spring-web, already on the classpath via starter-web —
             same client the bill and notification services use. -->

        <!-- Postgres driver (runtime only) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway: versioned SQL migrations in src/main/resources/db/migration.
             ADR-0003 applies here too — an applied migration is immutable. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testcontainers: a throwaway real Postgres for integration tests.
             NOTE worth acting on here: all 15 existing tests across wallet and bill call the
             service layer directly — none goes over HTTP. That is why four WalletController
             endpoints returned 500 from the day they were written and stayed green. This
             service is the BFF and its whole job is HTTP, so MockMvc tests belong here from
             the first increment, not retrofitted later. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Declare Lombok as an annotation processor explicitly (see wallet-service pom for why). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
